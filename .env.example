# Copy this file to .env and change the secrets. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_management

# Use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=*

# Business rules
ATTENDANCE_THRESHOLD=75
ATTENDANCE_EDIT_WINDOW_DAYS=7
